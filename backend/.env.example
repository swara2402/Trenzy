MONGODB_URI=mongodb://127.0.0.1:27017/smartcart
# Or Atlas: mongodb+srv://user:pass@cluster.mongodb.net/smartcart?retryWrites=true&w=majority

JWT_SECRET=change-this-to-a-random-64-char-string-use-openssl-rand-base64-32

PORT=5000
CLIENT_ORIGINS=http://127.0.0.1:3000,http://localhost:3000,http://localhost:5173
TRUST_PROXY=false
ENFORCE_HTTPS=false

# Optional
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

